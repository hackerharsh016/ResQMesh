{
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@protocol/*": ["src/protocol/*"],
      "@storage/*": ["src/storage/*"],
      "@identity/*": ["src/identity/*"],
      "@dtn/*": ["src/dtn/*"],
      "@transport/*": ["src/transport/*"],
      "@discovery/*": ["src/discovery/*"],
      "@routing/*": ["src/routing/*"],
      "@gateway/*": ["src/gateway/*"],
      "@app/*": ["src/app/*"],
      "@screens/*": ["src/screens/*"]
    }
  }
}
